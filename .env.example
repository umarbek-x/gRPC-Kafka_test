# Every setting has a working default for local development (see loadConfig
# in each cmd/*/main.go), so you only need this file to CHANGE something.
# Copy to .env and export, or set variables in your shell.

LOG_LEVEL=info                    # debug | info | warn | error

# --- shared ---
KAFKA_BROKERS=localhost:19092     # comma-separated list
SHUTDOWN_TIMEOUT=20s

# --- order-service ---
GRPC_ADDR=:50061
# POSTGRES_DSN=postgres://orderflow:orderflow@localhost:55432/orders?sslmode=disable
POSTGRES_MAX_CONNS=10
CONSUMER_WORKERS=8
OUTBOX_POLL_INTERVAL=200ms
ORDER_CACHE_SIZE=10000
ORDER_CACHE_TTL=30s

# --- payment-service ---
GATEWAY_LATENCY=50ms              # simulated provider latency
GATEWAY_FAILURE_RATE=0.1          # 10% transient errors -> watch the retries in the logs
GATEWAY_DECLINE_ABOVE_MINOR=100000 # orders above 1000.00 are declined

# --- notification-service ---
SEND_RATE_PER_SECOND=50
SEND_BURST=10
DISPATCHERS=4
